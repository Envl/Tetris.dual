{
  // Cloudflare Wrangler configuration converted from wrangler.toml
  "name": "tetris-dual-web",
  "main": "dist/worker.js",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKING",
        "class_name": "MatchmakingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "MatchmakingRoom"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "tetris_db",
      "database_name": "tetris-db",
      "database_id": "fd378a42-76ec-46e3-b586-87cd67ed983d"
    }
  ],
  "vars": {
    // Add any environment variables here
  }
}
